{
    "env": {
        "browser": true,
        "node": true,
        "es6": true
    },
    "extends": ["eslint:recommended", "plugin:react/recommended"],
    "parserOptions": {
        "ecmaFeatures": {
            "jsx": true
        },
        "ecmaVersion": 2018,
        "sourceType": "module"
    },
    "plugins": ["react"],
    "rules": {
        "quotes": ["error", "single", { "avoidEscape": true}],
        "semi": ["error", "always"],
        "react/prop-types": 0,
        "no-unused-vars": [2, { "vars": "all", "args": "after-used" }],
        "react/no-unescaped-entities": "off",
        "max-len": [
            1,
            100,
            4,
            {
                "ignorePattern": "^import\\s.+\\sfrom\\s.+;$",
                "ignoreUrls": true,
                "ignoreStrings": true,
                "ignoreTemplateLiterals": true,
                "ignoreComments": true
            }
        ]
    },
    "parser": "babel-eslint"
}
